# Cấu hình Môi trường cho Trading Advisory Chatbot

# ==========================================
# CẤU HÌNH LLM PROVIDER
# Chọn "openrouter" để chạy siêu mô hình 120B
# Chọn "google" để dùng Gemini 2.5 Flash qua AI Studio (nhanh & thông minh)
# Chọn "groq" để chạy trên Cloud (tốc độ cao)
# Chọn "ollama" để chạy nội bộ (miễn phí, chậm hơn)
# ==========================================
LLM_PROVIDER=openrouter

# ==========================================
# CẤU HÌNH OPENROUTER API
# Lấy API Key tại: https://openrouter.ai/keys
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# ==========================================
# CẤU HÌNH GROQ API
# Lấy API Key tại: https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL_NAME=qwen-3-32b

# ==========================================
# CẤU HÌNH GOOGLE AI STUDIO API (OpenAI Compatible)
# Lấy API Key tại: https://aistudio.google.com/app/apikey
# ==========================================
GOOGLE_API_KEY=AIzaSy_your_api_key_here
GOOGLE_MODEL_NAME=gemini-2.5-flash

# ==========================================
# CẤU HÌNH COHERE API (Dành cho Reranker siêu tốc)
# Lấy API Key tại: https://dashboard.cohere.com/api-keys
# ==========================================
COHERE_API_KEY=your_cohere_api_key_here

# ==========================================
# CẤU HÌNH LIVE DATA APIs (Lấy giá & nến)
# ==========================================
# Dành cho OANDA (Forex / Gold ưu tiên)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Dành cho Binance (Crypto, tùy chọn, vì Binance public API đã miễn phí)
BINANCE_API_KEY=

# Dành cho Twelve Data (Dự phòng)
TWELVE_DATA_API_KEY=