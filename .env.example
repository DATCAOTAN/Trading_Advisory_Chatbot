MARKET_SYMBOL_RELEVANT_CURRENCIES_BTCUSD=USD
MARKET_SYMBOL_RELEVANT_KEYWORDS_BTCUSD=bitcoin,btc,crypto,inflation,cpi,fomc,rate,yield,fed

