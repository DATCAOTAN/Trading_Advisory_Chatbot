# Trading Advisory Chatbot environment template.
# Do not put real credentials in this file.

# LLM provider
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free
GROQ_API_KEY=
GROQ_MODEL_NAME=qwen-3-32b
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-3.1-flash-lite
GOOGLE_FALLBACK_MODEL_NAME=gemini-flash-latest
COHERE_API_KEY=

# Live market data provider.
# Default live data path is the host-side MT5 bridge, not OANDA.
MARKET_DATA_PROVIDER=mt5_bridge

# Docker app to host-side MT5 bridge:
MT5_BRIDGE_URL=http://host.docker.internal:8765

# Native local app alternative:
# MT5_BRIDGE_URL=http://127.0.0.1:8765

MT5_BRIDGE_TIMEOUT_SECONDS=3
MT5_DEFAULT_CANDLE_COUNT=300
MT5_DEFAULT_TIMEFRAMES=M15,H1,H4
MT5_SYMBOL_MAP_XAUUSD=XAUUSD

# Optional legacy only. These are not required when MARKET_DATA_PROVIDER=mt5_bridge.
OANDA_LEGACY_ENABLED=false
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Optional public/legacy API placeholders.
BINANCE_API_KEY=
TWELVE_DATA_API_KEY=

# Knowledge parser
PDF_PARSER_MODE=pymupdf
INSTALL_MINERU=false
MINERU_PACKAGE=mineru[core]
MINERU_COMMAND=/opt/mineru_venv/bin/mineru
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_TIMEOUT_SECONDS=1800
MINERU_PARSE_BOOKS=false
MINERU_SELECTIVE_BOOK_PAGES_ENABLED=true
MINERU_SELECTIVE_MAX_PAGES_PER_DOC=5
MINERU_SELECTIVE_MAX_RANGES_PER_DOC=5
MINERU_SELECTIVE_LOW_TEXT_CHARS=300
MINERU_SELECTIVE_TABLE_LIKE_THRESHOLD=0.25
MINERU_SELECTIVE_IMAGE_AREA_RATIO=0.20
MINERU_FULL_MAX_PAGES_SOFT_LIMIT=25
MINERU_FULL_COMPLEX_PAGE_RATIO_THRESHOLD=0.35
PARSER_OUTPUT_SCHEMA_VERSION=adaptive_pdf_parse_v1

# Embedding/index reliability
EMBEDDING_PROVIDER=cohere
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=90
EMBEDDING_MAX_RETRIES=5
EMBEDDING_BACKOFF_BASE_SECONDS=10
EMBEDDING_BACKOFF_MAX_SECONDS=300
EMBEDDING_RATE_LIMIT_COOLDOWN_SECONDS=600
EMBEDDING_CIRCUIT_BREAKER_FAILURES=3
EMBEDDING_FAIL_FAST_ON_AUTH=true
EMBEDDING_RETRY_JITTER=true
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_BACKEND=sqlite
EMBEDDING_CACHE_PATH=/app/data/cache/embedding_cache.sqlite

# Knowledge update controls
KNOWLEDGE_UPDATE_RETRY_FAILED_ONLY=false
KNOWLEDGE_UPDATE_MAX_DOCS_PER_RUN=0
KNOWLEDGE_UPDATE_MAX_VECTORS_PER_RUN=0
KNOWLEDGE_UPDATE_STOP_ON_RATE_LIMIT=true
KNOWLEDGE_UPDATE_FAST_PRECHECK_ENABLED=true
KNOWLEDGE_UPDATE_FAST_PRECHECK_HASH_CACHE_ENABLED=true
KNOWLEDGE_UPDATE_FORCE_REPARSE=false
KNOWLEDGE_UPDATE_FORCE_REINDEX=false
KNOWLEDGE_UPDATE_LOG_PRECHECK=true

# Semantic context acquisition
SEMANTIC_CONTEXT_EXECUTOR_ENABLED=true
SEMANTIC_CONTEXT_EXECUTOR_AUTHORITATIVE=true
SEMANTIC_CONTEXT_REUSE_LEGACY_PREFETCH=true
SEMANTIC_CONTEXT_BLOCK_DUPLICATE_FETCH=true
SEMANTIC_CONTEXT_TASK_VIEWS_ENABLED=true
SEMANTIC_CONTEXT_KNOWLEDGE_USE_V3=true
SEMANTIC_CONTEXT_KNOWLEDGE_FALLBACK_TO_LEGACY=false
