# Cấu hình Môi trường cho Trading Advisory Chatbot

# ==========================================
# CẤU HÌNH LLM PROVIDER
# Chọn "openrouter" để chạy siêu mô hình 120B
# Chọn "google" để dùng Gemini 2.5 Flash qua AI Studio (nhanh & thông minh)
# Chọn "groq" để chạy trên Cloud (tốc độ cao)
# Chọn "ollama" để chạy nội bộ (miễn phí, chậm hơn)
# ==========================================
LLM_PROVIDER=openrouter

# ==========================================
# CẤU HÌNH OPENROUTER API
# Lấy API Key tại: https://openrouter.ai/keys
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# ==========================================
# CẤU HÌNH GROQ API
# Lấy API Key tại: https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL_NAME=qwen-3-32b

# ==========================================
# CẤU HÌNH GOOGLE AI STUDIO API (OpenAI Compatible)
# Lấy API Key tại: https://aistudio.google.com/app/apikey
# ==========================================
GOOGLE_API_KEY=AIzaSy_your_api_key_here
GOOGLE_MODEL_NAME=gemini-3.1-flash-lite
GOOGLE_FALLBACK_MODEL_NAME=gemini-flash-latest

# ==========================================
# CẤU HÌNH COHERE API (Dành cho Reranker siêu tốc)
# Lấy API Key tại: https://dashboard.cohere.com/api-keys
# ==========================================
COHERE_API_KEY=your_cohere_api_key_here

# ==========================================
# CẤU HÌNH LIVE DATA APIs (Lấy giá & nến)
# ==========================================
# Dành cho OANDA (Forex / Gold ưu tiên)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Dành cho Binance (Crypto, tùy chọn, vì Binance public API đã miễn phí)
BINANCE_API_KEY=

# Dành cho Twelve Data (Dự phòng)
TWELVE_DATA_API_KEY=

# ==========================================
# KNOWLEDGE V3 PDF PARSER
# ==========================================
# pymupdf      = use PyMuPDF only, safest/default fallback behavior
# adaptive     = probe with PyMuPDF, then choose PyMuPDF/MinerU/selective MinerU
# mineru_first = probe with PyMuPDF, prioritize MinerU for eligible reports
PDF_PARSER_MODE=pymupdf

# Set true when rebuilding Docker if you want MinerU installed into /opt/mineru_venv
INSTALL_MINERU=false

# Keep core by default. Use mineru[all] only if you really need the heavier backends.
MINERU_PACKAGE=mineru[core]

# Docker MinerU CLI path when INSTALL_MINERU=true
MINERU_COMMAND=/opt/mineru_venv/bin/mineru

# MinerU runtime options used by the parser adapter.
# Use pipeline by default; do not rely on MinerU hybrid-engine default.
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_TIMEOUT_SECONDS=1800

# Keep long text-based books on PyMuPDF unless a manifest explicitly requests MinerU.
MINERU_PARSE_BOOKS=false

# Adaptive selective parsing thresholds
MINERU_SELECTIVE_BOOK_PAGES_ENABLED=true
MINERU_SELECTIVE_MAX_PAGES_PER_DOC=5
MINERU_SELECTIVE_MAX_RANGES_PER_DOC=5
MINERU_SELECTIVE_LOW_TEXT_CHARS=300
MINERU_SELECTIVE_TABLE_LIKE_THRESHOLD=0.25
MINERU_SELECTIVE_IMAGE_AREA_RATIO=0.20
MINERU_FULL_MAX_PAGES_SOFT_LIMIT=25
MINERU_FULL_COMPLEX_PAGE_RATIO_THRESHOLD=0.35
PARSER_OUTPUT_SCHEMA_VERSION=adaptive_pdf_parse_v1

# ==========================================
# KNOWLEDGE V3 EMBEDDING / INDEX RELIABILITY
# ==========================================
# Keep Cohere for this sprint; retry/backoff makes indexing resume-safe.
EMBEDDING_PROVIDER=cohere
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=90
EMBEDDING_MAX_RETRIES=5
EMBEDDING_BACKOFF_BASE_SECONDS=10
EMBEDDING_BACKOFF_MAX_SECONDS=300
EMBEDDING_RATE_LIMIT_COOLDOWN_SECONDS=600
EMBEDDING_CIRCUIT_BREAKER_FAILURES=3
EMBEDDING_FAIL_FAST_ON_AUTH=true
EMBEDDING_RETRY_JITTER=true

# Cache completed embeddings so retries do not repay for successful batches.
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_BACKEND=sqlite
EMBEDDING_CACHE_PATH=/app/data/cache/embedding_cache.sqlite

# Resume controls for long Knowledge V3 updates.
KNOWLEDGE_UPDATE_RETRY_FAILED_ONLY=false
KNOWLEDGE_UPDATE_MAX_DOCS_PER_RUN=0
KNOWLEDGE_UPDATE_MAX_VECTORS_PER_RUN=0
KNOWLEDGE_UPDATE_STOP_ON_RATE_LIMIT=true

# Fast pre-parse skip for unchanged indexed documents.
KNOWLEDGE_UPDATE_FAST_PRECHECK_ENABLED=true
KNOWLEDGE_UPDATE_FAST_PRECHECK_HASH_CACHE_ENABLED=true
KNOWLEDGE_UPDATE_FORCE_REPARSE=false
KNOWLEDGE_UPDATE_FORCE_REINDEX=false
KNOWLEDGE_UPDATE_LOG_PRECHECK=true

# ==========================================
# SEMANTIC CONTEXT ACQUISITION RUNTIME
# ==========================================
# Make QueryPlan -> ContextExecutionPlan the source of truth for context fetching.
SEMANTIC_CONTEXT_EXECUTOR_ENABLED=true
SEMANTIC_CONTEXT_EXECUTOR_AUTHORITATIVE=true
SEMANTIC_CONTEXT_REUSE_LEGACY_PREFETCH=true
SEMANTIC_CONTEXT_BLOCK_DUPLICATE_FETCH=true
SEMANTIC_CONTEXT_TASK_VIEWS_ENABLED=true
SEMANTIC_CONTEXT_KNOWLEDGE_USE_V3=true
SEMANTIC_CONTEXT_KNOWLEDGE_FALLBACK_TO_LEGACY=false
